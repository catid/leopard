  "conclusion": {
    "result": "reject the one-shot balanced generic dispatch guard",
    "evidence": "Generic byte execution was 14.3%, 19.6%, and 16.3% faster at K=32,95,128 for the 64-byte half-loss cells, but the complete public one-shot call was 13.6%, 18.5%, and 14.7% slower. The setup/metadata cost reverses the core-only win.",
    "production_change": "none",
    "reusable_plan_semantics": "unchanged",
    "wire_identity": "unchanged"
  },
  "combined_raw_generic_follow_up": {
    "hypothesis": "A generic execution path can retain its 14-20% core advantage only if it is paired with the one-shot raw/minimal metadata representation and avoids compiling transient pruned schedules. Selecting generic before removing those setup costs cannot win the public call.",
    "design": [
      "Start from any separately accepted raw-view or one-shot schedule-elision candidate rather than stacking the rejected guard onto production code.",
      "For eligible exact one-shot plans, build only the locator state and minimal generic input/output dependency view required by ReedSolomonDecodePlanned; do not build reusable pruned transform schedules.",
      "Compare four same-source variants: translated-low regular metadata, translated-low raw metadata, generic regular metadata, and generic raw metadata.",
      "Select generic only after comparing complete public one-shot time for the raw translated-low and raw generic variants; the forced-core result is not a dispatch oracle.",
      "Keep caller-created reusable plans byte-agnostic and unchanged, and make the candidate internal-only so code/profile/field/wire identity cannot change."
    ],
    "initial_scope": {
      "field": "GF8",
      "backend": "AVX2",
      "profile": "LEGACY_HIGH_V1",
      "K_equals_R": true,
      "K_values": [32, 95, 128],
      "bytes": 64,
      "loss": "floor(R/2)",
      "batch_count": 1,
      "plan_kind": "exact one-shot transient"
    },
    "correctness_gate": "direct-oracle acceptance plus route assertions and identical per-case original/parity/recovered digests",
    "performance_gate": "two counterbalanced ABBA rounds must each show at least 5% complete public one-shot improvement in every target cell; B=256 and R-1 controls must not regress more than 2%",
    "kill_criterion": "reject if raw generic remains slower than raw translated-low in any target, or if metadata removal changes route determinism, reusable-plan behavior, correctness, or wire identity"
  }

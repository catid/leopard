  },
  "hypothesis": "GCC spills the indexed nibble-table arrays used by the two- and four-output source-major direct-repair kernels; explicitly named AVX2 table registers and dedicated dense kernels should eliminate those spills.",
  "implementation": {
    "dense_two_output": "load four named nibble-table vectors once per source and reuse the source nibble indices for both outputs",
    "dense_four_output": "load eight named nibble-table vectors once per source and reuse the source nibble indices for four outputs",
    "sparse_rows": "pair the first two active outputs and use the mature single-output kernel for any remainder",
    "eight_outputs": "execute two four-output passes because sixteen table vectors plus source and destination temporaries do not fit in the AVX2 register file",
    "single_output_preservation": "force-inline the templated body into a noinline AVX2FF8MultiplyAdd entry point so the additional sparse callers cannot make GCC outline the original hot operation"
  },
